{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wa-desk",
  "version": "0.3.0",
  "identifier": "dev.local.wadesk",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "wa-desk",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' wa-media: http://wa-media.localhost blob: data:; media-src 'self' wa-media: http://wa-media.localhost blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost wa-media: http://wa-media.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Local WhatsApp archive, search and tools",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"] } }
  }
}
